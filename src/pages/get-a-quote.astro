---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { page } from '../lib/config';
import { crumbsFor } from '../lib/schema';

const p = page('quote');
const crumbs = crumbsFor('quote');
---
<Base
  title="Free Roof Leak Inspection Orlando FL | Get a Quote"
  description="Request a free roof leak inspection in Orlando and Central Florida for shingle, tile, metal or flat roofs. We call you back fast. Leaking now? Call 24/7."
  path={p.path}
  crumbs={crumbs}
>
  <Hero
    h1="Get a Free Roof Leak Inspection"
    eyebrow="Free inspection"
    subhead="Water coming in right now? Don't wait for a callback. Call us."
    promise="Or fill out the short form. We'll call you back, look at your roof, show you photos of what we find, and give you a written price before any work starts."
    crumbs={crumbs}
    formLocation="quote_page"
    formHeading="Tell Us About Your Leak"
  />
  <HowItWorks />
  <RelatedLinks related={['emergency', 'leak-detection']} showQuote={false} />
</Base>
