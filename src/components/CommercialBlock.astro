---
import Icon from './Icon.astro';

interface Props {
  heading: string;
  intro: string;
  points: string[];
}
const { heading, intro, points } = Astro.props;
---
<section class="bg-slate-50 py-14">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">Property managers & HOAs</p>
      <h2 class="heading mt-2 text-3xl md:text-[2.4rem]">{heading}</h2>
      <p class="mt-4 text-lg text-slate-700">{intro}</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2">
      {points.map((p) => (
        <li class="flex gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
          <Icon name="check" class="h-6 w-6 shrink-0 text-accent-ink" />
          <span class="text-slate-800">{p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
