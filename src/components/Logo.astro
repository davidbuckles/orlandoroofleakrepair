---
import { config, logoFor } from '../lib/config';

interface Props {
  dark?: boolean;
  pageOverride?: boolean;
}
const { dark = false, pageOverride = false } = Astro.props;
const logo = pageOverride ? logoFor(Astro.url.pathname) : config.logo;
---
<a href="/" class="flex items-center gap-2.5" aria-label={`${config.site.businessName} home`}>
  <svg aria-hidden="true" viewBox="0 0 48 40" class="h-10 w-12 shrink-0">
    <path d="M2 18 24 4l22 14" fill="none" stroke={dark ? '#fff' : 'var(--brand)'} stroke-width="5" stroke-linejoin="round" />
    <path d="M10 19h28v4H10z" fill="var(--accent)" />
    <path d="M24 26c-2.6 3.8-3.9 5.7-3.9 7.6a3.9 3.9 0 0 0 7.8 0c0-1.9-1.3-3.8-3.9-7.6z" fill="var(--accent)" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-lg font-extrabold uppercase tracking-wide md:text-xl', dark ? 'text-white' : 'text-brand']}>{logo.line1}</span>
    <span class:list={['font-display text-[0.7rem] font-bold uppercase tracking-[0.28em] md:text-xs', dark ? 'text-accent' : 'text-accent-ink']}>{logo.line2}</span>
  </span>
</a>
