---
import CallButton from './CallButton.astro';
import Logo from './Logo.astro';
import { config, page } from '../lib/config';

const links = config.nav.map((id) => page(id));
const current = Astro.url.pathname;
---
<header class="z-40 md:sticky md:top-0 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2.5">
    <Logo pageOverride />
    <nav aria-label="Main" class="hidden items-center gap-7 font-display text-[0.95rem] font-bold text-brand lg:flex">
      {links.map((l) => (
        <a
          href={l.path}
          class:list={[
            'border-b-2 py-1 transition hover:border-accent',
            current === l.path ? 'border-accent' : 'border-transparent',
          ]}
          aria-current={current === l.path ? 'page' : undefined}
        >{l.label}</a>
      ))}
    </nav>
    <div class="hidden md:block">
      <CallButton location="header" size="md" />
    </div>
  </div>
  <nav aria-label="Main mobile" class="flex gap-5 overflow-x-auto border-t border-slate-100 px-4 py-2 font-display text-sm font-bold text-brand [scrollbar-width:none] lg:hidden">
    {links.map((l) => (
      <a href={l.path} class:list={['whitespace-nowrap border-b-2', current === l.path ? 'border-accent' : 'border-transparent']}>{l.label}</a>
    ))}
  </nav>
</header>
