---
interface Props {
  crumbs: { name: string; path: string }[];
  dark?: boolean;
}
const { crumbs, dark = false } = Astro.props;
---
{crumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class:list={['mb-4 text-sm', dark ? 'text-slate-300' : 'text-slate-500']}>
    <ol class="flex flex-wrap gap-1">
      {crumbs.map((c, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i < crumbs.length - 1 ? <a href={c.path} class="hover:underline">{c.name}</a> : <span aria-current="page">{c.name}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
