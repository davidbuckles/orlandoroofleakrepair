---
import { config, telHref } from '../lib/config';

interface Props {
  location: string;
  size?: 'lg' | 'md';
  class?: string;
}
const { location, size = 'lg', class: cls = '' } = Astro.props;
---
<a
  href={telHref}
  data-location={location}
  class:list={[
    'inline-flex items-center justify-center gap-3 rounded-md bg-accent font-display text-brand-dark shadow-md transition hover:bg-accent-dark focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/50',
    size === 'lg' ? 'px-6 py-3' : 'px-4 py-2',
    cls,
  ]}
>
  <svg aria-hidden="true" class={size === 'lg' ? 'h-7 w-7 shrink-0' : 'h-6 w-6 shrink-0'} viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
  <span class="flex flex-col text-left leading-tight">
    <span class:list={['font-extrabold', size === 'lg' ? 'text-2xl' : 'text-lg']}>{config.contact.phoneDisplay}</span>
    <span class="text-xs font-bold uppercase tracking-[0.14em]">{config.claims.emergency247 ? 'Call now · 24/7' : 'Call now'}</span>
  </span>
</a>
