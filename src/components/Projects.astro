---
import { Image } from 'astro:assets';
import { config } from '../lib/config';
import { photo } from '../lib/photos';

// Renders only when real job photos are listed in site.config.json -> photos.projects.
type Project = { file: string; title: string; city: string; alt: string };
const projects = (config.photos.projects as Project[]).map((p) => ({ ...p, img: photo(p.file)! }));
---
{projects.length > 0 && (
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4">
      <p class="eyebrow">Recent roof leak repairs</p>
      <h2 class="heading mt-2 text-3xl md:text-[2.6rem]">Real Repairs. Real Results.</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {projects.map((p) => (
          <li>
            <Image src={p.img} alt={p.alt} widths={[400, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full rounded-md object-cover" />
            <p class="mt-3 font-display text-lg font-bold text-brand">{p.title}</p>
            <p class="text-sm text-slate-600">{p.city}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
