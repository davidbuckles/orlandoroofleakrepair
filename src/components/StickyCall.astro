---
import { config, telHref } from '../lib/config';
---
<div class="fixed inset-x-0 bottom-0 z-50 bg-brand-dark p-2 shadow-[0_-4px_12px_rgba(0,0,0,0.2)] md:hidden">
  <a
    href={telHref}
    data-location="sticky_bar"
    class="flex w-full items-center justify-center gap-2 rounded-md bg-accent py-3.5 font-display text-lg font-extrabold uppercase tracking-wide text-brand-dark"
  >
    <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
    Call Now · {config.contact.phoneDisplay}
  </a>
</div>
