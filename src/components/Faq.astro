---
interface Props {
  faqs: { q: string; a: string }[];
}
const { faqs } = Astro.props;
---
<section class="bg-slate-50 py-14">
  <div class="mx-auto max-w-3xl px-4">
    <p class="eyebrow">Questions we hear a lot</p>
    <h2 class="heading mt-2 text-3xl md:text-[2.4rem]">Common Questions</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details data-faq={f.q} class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
          <summary class="flex items-start justify-between gap-4 font-display text-lg font-bold text-brand">
            <span>{f.q}</span>
            <span class="faq-icon mt-0.5 text-2xl leading-none text-accent-ink transition-transform" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-slate-700">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
