---
import Icon from './Icon.astro';
import { page, servicePageIds } from '../lib/config';

interface Props {
  exclude?: string;
}
const { exclude } = Astro.props;
const cards = servicePageIds.filter((id) => id !== exclude).map((id) => page(id));
---
<section class="border-b border-slate-200 bg-white">
  <ul class="mx-auto grid max-w-7xl grid-cols-2 md:grid-cols-3 lg:flex lg:divide-x lg:divide-slate-200">
    {cards.map((p) => (
      <li class="border-b border-r border-slate-100 lg:flex-1 lg:border-0">
        <a href={p.path} class="group flex h-full flex-col items-center px-3 py-7 text-center transition hover:bg-slate-50">
          <Icon name={p.card!.icon as any} class="h-10 w-10 text-brand transition group-hover:text-accent-ink" />
          <span class="mt-3 font-display text-base font-extrabold uppercase leading-tight text-brand">{p.card!.title}</span>
          <span class="mt-1 text-sm text-slate-600">{p.card!.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
