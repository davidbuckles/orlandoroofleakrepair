---
import Icon from './Icon.astro';
import { page, servicePageIds } from '../lib/config';

const current = Astro.url.pathname;
const cards = servicePageIds.map((id) => page(id));
---
<section class="border-b border-slate-200 bg-white">
  <ul class="mx-auto grid max-w-7xl grid-cols-2 md:grid-cols-4">
    {cards.map((p) => (
      <li class="border-b border-r border-slate-100">
        <a
          href={p.path}
          aria-current={current === p.path ? 'page' : undefined}
          class:list={[
            'group flex h-full flex-col items-center px-3 py-6 text-center transition hover:bg-slate-50',
            current === p.path && 'bg-slate-50 shadow-[inset_0_-3px_0_var(--accent)]',
          ]}
        >
          <Icon name={p.card!.icon as any} class="h-10 w-10 text-brand transition group-hover:text-accent-ink" />
          <span class="mt-3 font-display text-base font-extrabold uppercase leading-tight text-brand">{p.card!.title}</span>
          <span class="mt-1 text-sm text-slate-600">{p.card!.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
